<misterromdescription>
    <rbf>ffaligator</rbf>
    <name>Alligator Hunt (FF, Gaelco, 1994)</name>
    <setname>aligator</setname>
    <year>1994</year>
    <manufacturer>Gaelco</manufacturer>
    <players>2</players>
    <buttons>3</buttons>
    <rotation>horizontal</rotation>
