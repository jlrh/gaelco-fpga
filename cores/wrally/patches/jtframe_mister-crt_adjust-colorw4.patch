+// CRT_ADJUST (si esta activo) siempre saca 8 bits/canal fijos (crt_adjust.sv es de anchura fija),
+// sea cual sea el COLORW de entrada del core -- final_rgb de mas abajo es SIEMPRE 24 bits en ese
+// camino. Sin este `ifdef`, COLORW=4 (wrally) daba VIDEO_DW=12 (formula pensada solo para COLORW=5
+// u 8, donde 3*COLORW ya salia a 24 por coincidencia) -> arcade_video truncaba los 24 bits reales
+// de final_rgb a 12, leyendo trozos de canal que no eran los reales -> colores rotos en pantalla
+// (bug real, 2026-09-17, encontrado al integrar CRT_ADJUST en wrally). El camino SIN CRT_ADJUST no
+// se toca: sigue siendo 3*COLORW para cualquier COLORW!=5 (no romper los cores Tipo-1 que ya
+// funcionan sin CRT_ADJUST, p.ej. squash/thoop/biomtoy).
+`ifdef CRT_ADJUST
+localparam VIDEO_DW = 24;
+`else
 localparam VIDEO_DW = COLORW!=5 ? 3*COLORW : 24;
+`endif
 
 wire [VIDEO_DW-1:0] game_rgb;
 wire [COLORW-1:0] base_r, base_g, base_b;
